# Local default; replace with a managed PostgreSQL URL in deployed environments.
DATABASE_URL=sqlite:///./homista.db
FIREBASE_PROJECT_ID=your-firebase-project-id
# Point to a service account file only for local development. Prefer workload
# identity / Application Default Credentials in deployed environments.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Generate a unique random value of at least 32 bytes; never commit a real key.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ISSUER=homista-api
JWT_AUDIENCE=homista-mobile
